<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_dialog_rounded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/lnTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dimen_16dp"
        android:paddingTop="@dimen/dimen_10dp"
        android:paddingBottom="@dimen/dimen_24dp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dimen_8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/profile_menu_title"
            android:textColor="@color/color_001737"
            android:textSize="@dimen/dimen_17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:scaleType="fitXY"
            android:src="@drawable/ic_close_30" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16dp"
        android:text="@string/full_name_title"
        android:textColor="@color/color_001737"
        android:textSize="@dimen/dimen_13sp"
        android:layout_marginStart="@dimen/dimen_16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lnTitle" />

    <EditText
        android:id="@+id/edtName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4dp"
        android:background="@drawable/shape_schedule_take_photo_normal"
        android:gravity="center_vertical"
        android:text="Vũ Hồng Ngọc"
        android:layout_marginHorizontal="@dimen/dimen_16dp"
        android:paddingHorizontal="@dimen/dimen_14dp"
        android:paddingVertical="@dimen/dimen_10dp"
        android:textColor="@color/color_4B4B4B"
        android:textColorHint="@color/color_B6B6B6"
        android:textSize="@dimen/dimen_13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvName" />

    <TextView
        android:id="@+id/tvEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16dp"
        android:text="@string/full_name_title"
        android:textColor="@color/color_001737"
        android:textSize="@dimen/dimen_13sp"
        android:layout_marginStart="@dimen/dimen_16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edtName" />

    <EditText
        android:id="@+id/edtEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4dp"
        android:background="@drawable/shape_schedule_take_photo_normal"
        android:gravity="center_vertical"
        android:text="ngocvh@gmail.com"
        android:layout_marginHorizontal="@dimen/dimen_16dp"
        android:paddingHorizontal="@dimen/dimen_14dp"
        android:paddingVertical="@dimen/dimen_10dp"
        android:textColor="@color/color_4B4B4B"
        android:textColorHint="@color/color_B6B6B6"
        android:textSize="@dimen/dimen_13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEmail" />

    <TextView
        android:id="@+id/tvPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16dp"
        android:text="@string/full_name_title"
        android:textColor="@color/color_001737"
        android:textSize="@dimen/dimen_13sp"
        android:layout_marginStart="@dimen/dimen_16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edtEmail" />

    <EditText
        android:id="@+id/edtPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_4dp"
        android:background="@drawable/shape_schedule_take_photo_normal"
        android:gravity="center_vertical"
        android:text="812 3456"
        android:layout_marginHorizontal="@dimen/dimen_16dp"
        android:paddingHorizontal="@dimen/dimen_14dp"
        android:paddingVertical="@dimen/dimen_10dp"
        android:textColor="@color/color_4B4B4B"
        android:textColorHint="@color/color_B6B6B6"
        android:textSize="@dimen/dimen_13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPhone" />

    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:paddingBottom="@dimen/dimen_24dp"
        android:layout_marginHorizontal="@dimen/dimen_16dp"
        app:layout_constraintTop_toBottomOf="@id/edtPhone"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmNo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_back"
            android:minHeight="0dp"
            android:paddingHorizontal="@dimen/dimen_8dp"
            android:textAllCaps="false"
            android:paddingVertical="@dimen/dimen_10dp"
            android:text="@string/cancel_title"
            android:textColor="@color/color_EE0033"
            android:textStyle="bold" />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmYes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_login"
            android:minHeight="0dp"
            android:textAllCaps="false"
            android:paddingVertical="@dimen/dimen_10dp"
            android:text="@string/submit_button"
            android:textColor="@color/white"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


